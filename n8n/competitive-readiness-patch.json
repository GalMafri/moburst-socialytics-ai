    {
      "name": "Check RivalIQ Readiness",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const status = $input.first().json.status;\nif (status !== 1 && status !== 2) {\n  throw new Error('RivalIQ did not return a valid data-readiness status. No analysis was started.');\n}\nif (status === 2 && $runIndex >= 30) {\n  throw new Error('RivalIQ is still collecting source data after 30 minutes. Retry this report after tracking has finished; no incomplete figures were released.');\n}\nreturn [{ json: { status, ready: status === 1, checks: $runIndex + 1 } }];\n"
      },
      "position": [
        -200,
        640
      ]
    },
    {
      "name": "RivalIQ Ready",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "parameters": {
