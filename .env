# Committed on purpose: Lovable's builder and deploy.sh both build from this
# file, and there is no other env source. Removing it breaks production.
#
# Vite inlines every VITE_* value into the client bundle at build time, so
# treat everything here as public. Never add a service-role key or any secret.
#
# VITE_DEV_MODE was removed: it forced IS_LOVABLE_PREVIEW true in the production
# build, so logged-out visitors to the branded URL were shown the fake DEV_USER
# as an admin, with every query then failing on permission denied.
# For local work use `npm run dev` (import.meta.env.DEV covers it).

VITE_SUPABASE_PROJECT_ID="rwouwxqggjjacbpbhqsn"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJ3b3V3eHFnZ2pqYWNicGJocXNuIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzA3MjI5MjUsImV4cCI6MjA4NjI5ODkyNX0.MVh6NOBLeBFvgYlxa9Ye9y6fTX3fQrMuo-YcwwJL5hU"
VITE_SUPABASE_URL="https://rwouwxqggjjacbpbhqsn.supabase.co"
VITE_HUB_BACKEND_URL="https://tools-server.moburst.com"
